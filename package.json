{
  "name": "barbershop-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm --workspace=client run dev",
    "dev:client": "npm --workspace=client run dev",
    "dev:server": "npm --workspace=server run dev",
    "build": "npm --workspace=client run build",
    "start": "npm --workspace=server start",
    "seed": "npm --workspace=server run seed",
    "lint": "npm --workspace=client run lint",
    "lint:fix": "npm --workspace=client run lint:fix",
    "format": "npm --workspace=client run format",
    "test": "npm run test:client && npm run test:server",
    "test:client": "npm --workspace=client run test",
    "test:server": "npm --workspace=server run test",
    "test:e2e": "playwright test",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.2"
  }
}
