# Environment configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database configuration
MONGO_URI=mongodb://localhost:27017/barbershop

# JWT configuration
JWT_SECRET=super_secret_jwt_key_for_development_purposes_only_change_in_prod
JWT_EXPIRES_IN=7d
COOKIE_NAME=barbershop_auth_token

# Initial Owner Admin credentials for seed
OWNER_NAME=Barbershop Master
OWNER_EMAIL=owner@barbershop.com
OWNER_PASSWORD=Admin@123456

# Optional Future Automated Notification Providers (server/src/services/notifications)
# WHATSAPP_CLOUD_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# SMTP_HOST=
# SMTP_USER=
